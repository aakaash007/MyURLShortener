# Local PostgreSQL connection created by docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/url_shortener

# Leave empty locally; set this to the deployed HTTPS backend address in production.
PUBLIC_BASE_URL=

# Add comma-separated frontend origins only when the frontend is hosted separately.
CORS_ORIGINS=
ENVIRONMENT=development
LINK_CREATION_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60

